#include <windows.h>
#include <mirrorfly/build_version.hpp>

IDI_ICON1 ICON "mirrorfly.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MIRRORFLY_VERSION_NUMBERS
PRODUCTVERSION MIRRORFLY_VERSION_NUMBERS
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mirrorfly"
            VALUE "FileDescription", "Mirrorfly Office"
            VALUE "FileVersion", MIRRORFLY_VERSION_STRING
            VALUE "ProductName", "Mirrorfly Office"
            VALUE "ProductVersion", MIRRORFLY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
